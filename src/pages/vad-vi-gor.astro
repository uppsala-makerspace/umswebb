---
/* Workshops and areas of interest, from the members API. An .astro page rather
 * than a content file so the carousel component can be used directly. */
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCarousel from '../components/EntryCarousel.astro';
import { getEntries } from '../lib/entries';

const entries = await getEntries();
---
<BaseLayout
  title="Vad vi gör — Uppsala Makerspace"
  description="Verkstäderna och intresseområdena på Uppsala Makerspace."
  lang="sv"
>
  <h1>Vad vi gör</h1>
  <p>
    Våra verkstäder är rum med maskiner och verktyg för olika material och tekniker.
    Intresseområdena samlas kring ett gemensamt intresse snarare än ett rum och håller
    oftast till i verkstädernas lokaler.
  </p>

  <EntryCarousel entries={entries} lang="sv" />
</BaseLayout>
