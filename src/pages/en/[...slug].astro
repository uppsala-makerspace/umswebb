---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarkdownGallery from '../../components/MarkdownGallery.astro';
import FloorMapEmbed from '../../components/FloorMapEmbed.astro';
import BoardList from '../../components/BoardList.astro';
import { pageSlug } from '../../lib/slug';
import { primaryNav } from '../../data/nav';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => data.lang === 'en' && !data.draft);
  return pages.map(page => ({
    params: { slug: pageSlug(page) },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);

const pageHref = `/en/${pageSlug(page)}/`;
const navItem = primaryNav.find(n => !n.external && n.href.en === pageHref);
const heading = navItem?.label.en ?? page.data.title;

// The map ships a JSON blob of every room plus its script, so only pages that
// actually embed one pay for it.
const hasFloorMap = page.body?.includes('data-floor-map') ?? false;
const hasBoard = page.body?.includes('data-board') ?? false;
---
<BaseLayout title={heading} description={page.data.description} lang="en" prose>
  <article>
    <h1>{heading}</h1>
    <Content />
  </article>
  <MarkdownGallery lang="en" />
  {hasFloorMap && <FloorMapEmbed lang="en" />}
  {hasBoard && <BoardList lang="en" />}
</BaseLayout>
