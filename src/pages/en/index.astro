---
/* English home page — mirrors `/`, see src/pages/index.astro. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoPile from '../../components/PhotoPile.astro';
---
<BaseLayout title="Uppsala Makerspace" description="Uppsala Makerspace — make, learn, share." lang="en">
  <section class="home-masthead">
    <h1 class="visually-hidden">Uppsala Makerspace</h1>
    <img class="home-logo" src="/icons/Logos/SVG/Logo_Complex_Black.svg" alt="Uppsala Makerspace" />
  </section>

  <div class="home-intro">
    <p>
      Uppsala Makerspace is a non-profit association with a workshop in Ekebybruk, west of central
      Uppsala. Here you'll find machines, tools and room to create — on your own or together with
      others who are happy to share what they know.
    </p>
    <p>
      Everyone is welcome. Come and say hello at an <a href="/en/calendar/">open evening</a>, read
      more about <a href="/en/our-space/">our space and how to find us</a>, or
      <a href="/en/become-a-member/">become a member</a> if you want to come and go as you please.
    </p>
  </div>

  <PhotoPile lang="en" />
</BaseLayout>
