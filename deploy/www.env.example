# /etc/umswebb/www.env — the production site. Installed by install.sh on first
# run and never overwritten after that; edit it in place on the server.
REPO_URL=https://github.com/uppsala-makerspace/umswebb.git
BRANCH=main
WEBROOT=/var/www/www.uppsalamakerspace.se
UMS_SITE_URL=https://www.uppsalamakerspace.se
UMS_API_URL=https://umsme.uppsalamakerspace.se/api/public/entries
UMS_APP_URL=https://app.uppsalamakerspace.se
