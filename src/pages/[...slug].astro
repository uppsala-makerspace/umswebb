---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSlug } from '../lib/slug';
import { primaryNav } from '../data/nav';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => data.lang === 'sv' && !data.draft);
  return pages.map(page => ({
    params: { slug: pageSlug(page) },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);

// Prefer the menu label as the visible heading so the page title matches
// what visitors clicked to get here. Falls back to the markdown title when
// the page isn't in the primary nav.
const pageHref = `/${pageSlug(page)}/`;
const navItem = primaryNav.find(n => !n.external && n.href.sv === pageHref);
const heading = navItem?.label.sv ?? page.data.title;
---
<BaseLayout title={heading} description={page.data.description} lang="sv" prose>
  <article>
    <h1>{heading}</h1>
    <Content />
  </article>
</BaseLayout>
