---
/* The calendar, built from the occasions published in umsme: events of
 * activities and free-standing ones alike. See `getOccasions()`. */
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendarSubscribe from '../components/CalendarSubscribe.astro';
import OccasionList from '../components/OccasionList.astro';
import { getOccasions } from '../lib/entries';

const occasions = await getOccasions();
---
<BaseLayout
  title="Kalendern — Uppsala Makerspace"
  description="Kommande aktiviteter, workshops och öppna kvällar på Uppsala Makerspace."
  lang="sv"
>
  <CalendarSubscribe lang="sv" title="Kalendern" />
  <p>
    Nedan är de planerade tillfällena. För en mer komplett bild, se våra
    <a href="/aktiviteter/">aktiviteter</a>.
  </p>

  <OccasionList occasions={occasions} lang="sv" />
</BaseLayout>
