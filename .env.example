# Copy to .env on the machine that builds the site. Nothing here is secret —
# these only say which hosts a build talks to and which URL it belongs to.
#
# The defaults in the code are the development ones, so a local build needs no
# .env at all as long as umsme runs on :3000 and the member app on :3001.

# Workshops, areas of interest, groups, spaces and the palette. Fetched on every
# build — no API, no build. See umsme/docs/public-api.md.
UMS_API_URL=https://umsme.uppsalamakerspace.se/api/public/entries

# The member app, whose static assets include the two floor plans that the map on
# /lokalen/ draws. Not part of the API.
UMS_APP_URL=https://app.uppsalamakerspace.se

# What this deployment is reachable as. Defaults to the production site; staging
# is https://beta.uppsalamakerspace.se.
UMS_SITE_URL=https://www.uppsalamakerspace.se
