---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postSlug } from '../../../lib/slug';

const PAGE_SIZE = 20;
const all = (await getCollection('posts', ({ data }) => data.lang === 'en' && !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const posts = all.slice(0, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const dtf = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title="News — Uppsala Makerspace" description="News from Uppsala Makerspace." lang="en">
  <h1>News</h1>
  {all.length === 0 ? (
    <p>No English news yet.</p>
  ) : (
    <>
      <p><small>Page 1 of {totalPages}</small></p>
      <ul class="news-list">
        {posts.map(post => (
          <li>
            <time datetime={post.data.date.toISOString()}>{dtf.format(post.data.date)}</time>
            <a href={`/en/news/${postSlug(post)}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
      {totalPages > 1 && (
        <nav><a href="/en/news/page/2/">Next →</a></nav>
      )}
    </>
  )}
</BaseLayout>
