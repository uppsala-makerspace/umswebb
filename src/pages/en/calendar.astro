---
/* The calendar, built from the occasions published in umsme: events of
 * activities and free-standing ones alike. See `getOccasions()`. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalendarSubscribe from '../../components/CalendarSubscribe.astro';
import OccasionList from '../../components/OccasionList.astro';
import { getOccasions } from '../../lib/entries';

const occasions = await getOccasions();
---
<BaseLayout
  title="Calendar — Uppsala Makerspace"
  description="Upcoming activities, workshops, and open evenings at Uppsala Makerspace."
  lang="en"
>
  <CalendarSubscribe lang="en" title="Calendar" />
  <p>
    Below are the planned occasions. For a more complete picture, see our
    <a href="/en/activities/">activities</a>.
  </p>

  <OccasionList occasions={occasions} lang="en" />
</BaseLayout>
