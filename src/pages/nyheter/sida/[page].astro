---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postSlug } from '../../../lib/slug';

export async function getStaticPaths() {
  const PAGE_SIZE = 20;
  const all = (await getCollection('posts', ({ data }) => data.lang === 'sv' && !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const totalPages = Math.ceil(all.length / PAGE_SIZE);
  const paths = [];
  for (let p = 2; p <= totalPages; p++) {
    paths.push({
      params: { page: String(p) },
      props: {
        posts: all.slice((p - 1) * PAGE_SIZE, p * PAGE_SIZE),
        currentPage: p,
        totalPages,
      },
    });
  }
  return paths;
}

const { posts, currentPage, totalPages } = Astro.props;
const dtf = new Intl.DateTimeFormat('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' });
const prevHref = currentPage === 2 ? '/nyheter/' : `/nyheter/sida/${currentPage - 1}/`;
const nextHref = currentPage < totalPages ? `/nyheter/sida/${currentPage + 1}/` : null;
---
<BaseLayout title={`Nyheter — sida ${currentPage} — Uppsala Makerspace`} description="Nyheter från Uppsala Makerspace." lang="sv">
  <h1>Nyheter</h1>
  <p><small>Sida {currentPage} av {totalPages}</small></p>
  <ul>
    {posts.map(post => (
      <li>
        <a href={`/nyheter/${postSlug(post)}/`}>{post.data.title}</a>
        <br />
        <small><time datetime={post.data.date.toISOString()}>{dtf.format(post.data.date)}</time></small>
      </li>
    ))}
  </ul>
  <nav>
    <a href={prevHref}>← Föregående</a>
    {nextHref && <> · <a href={nextHref}>Nästa →</a></>}
  </nav>
</BaseLayout>
