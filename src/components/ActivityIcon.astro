---
/* Two squares, one over the other: the mark for "this occasion is one of an
 * activity's". Not an arrow, which would say the link goes to the occasion
 * itself. Decorative — whoever uses it carries the words. */
---
<svg class="act-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
  <rect x="8" y="8" width="13" height="13" rx="2" />
  <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
</svg>

<style>
  .act-icon {
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
