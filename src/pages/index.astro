---
/* Home page: logo and a short intro. The workshops and areas of interest live on
 * /vad-vi-gor/. Masthead and intro styles are shared with `/en/` and live in
 * global.css. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoPile from '../components/PhotoPile.astro';
---
<BaseLayout title="Uppsala Makerspace" description="Uppsala Makerspace — skapa, lär, dela." lang="sv">
  <section class="home-masthead">
    <h1 class="visually-hidden">Uppsala Makerspace</h1>
    <img class="home-logo" src="/icons/Logos/SVG/Logo_Complex_Black.svg" alt="Uppsala Makerspace" />
  </section>

  <div class="home-intro">
    <p>
      Uppsala Makerspace är en ideell förening med en verkstad i Ekebybruk, väster om Uppsala
      centrum. Här finns maskiner, verktyg och plats att skapa — på egen hand eller tillsammans
      med andra som gärna delar med sig av vad de kan.
    </p>
    <p>
      Alla är välkomna. Kom och hälsa på en <a href="/kalender/">öppen kväll</a>, läs mer om
      <a href="/lokalen/">lokalen och hur du hittar hit</a>, eller
      <a href="/bli-medlem/">bli medlem</a> om du vill kunna komma och gå som du vill.
    </p>
  </div>

  <PhotoPile lang="sv" />
</BaseLayout>
