# /etc/umswebb/beta.env — the staging site. Installed by install.sh on first
# run and never overwritten after that; edit it in place on the server.
# Point BRANCH at another branch to preview it before it reaches main.
REPO_URL=https://github.com/uppsala-makerspace/umswebb.git
BRANCH=main
WEBROOT=/var/www/beta.uppsalamakerspace.se
UMS_SITE_URL=https://beta.uppsalamakerspace.se
UMS_API_URL=https://umsme.uppsalamakerspace.se/api/public/entries
UMS_APP_URL=https://app.uppsalamakerspace.se
